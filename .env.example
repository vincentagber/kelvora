# ==============================================================================
# KELVORA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT & RUNTIME
# ------------------------------------------------------------------------------
# Project URL (Frontend & SSR)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Client-Side Framework Mappings
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ------------------------------------------------------------------------------
# 2. SUPABASE SERVER / SERVICE ROLE 
# ------------------------------------------------------------------------------
# Service role key bypassing RLS for trusted server functions
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE & POOLING
# ------------------------------------------------------------------------------
# Transaction-mode connection pooler for serverless & production traffic (Port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for schema migrations and DDL operations (Port 5432)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Optional direct credentials
PGHOST="db.your-project.supabase.co"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="your-db-password"

# ------------------------------------------------------------------------------
# 4. OUTBOUND NOTIFICATIONS & DISPATCHERS (EMAIL / SMS / WHATSAPP)
# ------------------------------------------------------------------------------
# Email Driver: "smtp" | "supabase" | "resend" | "console"
EMAIL_DRIVER="smtp"
EMAIL_FROM="Kelvora <kelvora@useprocurely.com>"

# Direct SMTP Server Configuration (cPanel SSL/TLS or custom mail server)
SMTP_HOST="useprocurely.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="kelvora@useprocurely.com"
SMTP_PASS="B[vw~J}7K=qHz?mX"

RESEND_API_KEY="re_..."

# WhatsApp / SMS Driver: "termii" | "whatsapp_cloud" | "console"
WHATSAPP_DRIVER="console"
TERMII_API_KEY=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ------------------------------------------------------------------------------
# 5. ENTERPRISE PAYMENT GATEWAYS (VIRTUAL ACCOUNTS & SETTLEMENT)
# ------------------------------------------------------------------------------
# Gateway: "monnify" | "paystack" | "providus" | "manual"
PAYMENT_GATEWAY_DRIVER="manual"
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""

PAYSTACK_SECRET_KEY="sk_live_..."
PAYSTACK_PUBLIC_KEY="pk_live_..."

# ------------------------------------------------------------------------------
# 6. APPLICATION SECURITY & SIGNING
# ------------------------------------------------------------------------------
# Secret key for HMAC-SHA256 enterprise ERP webhooks and token signing
# Application Base URL (used in email notification & password reset links)
# e.g. https://your-render-subdomain.onrender.com or http://localhost:3000
APP_BASE_URL="https://your-render-subdomain.onrender.com"

